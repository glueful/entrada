{
    "name": "glueful/entrada",
    "description": "Entrada: Social Login & SSO for Glueful (OAuth/OIDC)",
    "type": "glueful-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Tawiah Sowah",
            "email": "michael@glueful.dev"
        }
    ],
    "keywords": [
        "authentication",
        "social-integration",
        "oauth",
        "facebook",
        "google",
        "github"
    ],
    "require": {
        "php": "^8.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "glueful/framework": "^1.79",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.0"
    },
    "homepage": "https://github.com/glueful/entrada",
    "autoload": {
        "psr-4": {
            "Glueful\\Extensions\\Entrada\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Glueful\\Extensions\\Entrada\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpcs": "vendor/bin/phpcs",
        "phpcbf": "vendor/bin/phpcbf",
        "analyze": "vendor/bin/phpstan analyze src",
        "build": "php scripts/build.php",
        "deploy": "php scripts/deploy.php"
    },
    "extra": {
        "glueful": {
            "name": "Entrada",
            "displayName": "Entrada",
            "description": "Social Login & SSO for Glueful (OAuth/OIDC)",
            "version": "1.12.0",
            "icon": "assets/icon.png",
            "galleryBanner": {
                "color": "#2563EB",
                "theme": "dark"
            },
            "categories": [
                "authentication",
                "sso",
                "oauth"
            ],
            "publisher": "glueful-team",
            "provider": "Glueful\\Extensions\\Entrada\\Services\\EntradaServiceProvider",
            "requires": {
                "glueful": ">=1.79.0",
                "extensions": []
            },
            "migrations": [
                {
                    "id": "default",
                    "path": "migrations",
                    "priority": "dependent",
                    "mode": "on_enable",
                    "verifier": "Glueful\\Extensions\\Entrada\\Schema\\EntradaSchemaVerifier"
                }
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
